{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BLCCoreStudio/OpenDevIndex/schema/entry.schema.json",
  "title": "OpenDevIndex knowledge module metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "summary",
    "status",
    "verified_at",
    "tags",
    "sources"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2, 3, 4] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "category": {
      "enum": [
        "tool", "language", "framework", "library", "runtime", "platform",
        "database", "protocol", "standard", "system", "toolchain", "service",
        "project", "concept", "hardware", "architecture", "algorithm", "model",
        "format", "device", "dataset", "technique", "ai", "security", "cloud",
        "opensource"
      ]
    },
    "kind": {
      "enum": [
        "tool", "language", "framework", "library", "runtime", "platform",
        "database", "protocol", "standard", "system", "toolchain", "service",
        "project", "concept", "hardware", "architecture", "algorithm", "model",
        "format", "device", "dataset", "technique", "operating-system", "kernel",
        "specification"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "summary": { "type": "string", "minLength": 40, "maxLength": 320 },
    "homepage": { "type": ["string", "null"], "format": "uri" },
    "repository": { "type": ["string", "null"], "format": "uri" },
    "license": { "type": ["string", "null"], "maxLength": 100 },
    "deployment_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cli", "desktop", "device", "embedded", "firmware", "hardware", "hybrid",
          "library", "local", "mobile", "saas", "self-hosted", "service", "system", "web"
        ]
      }
    },
    "status": { "enum": ["active", "maintenance", "deprecated", "historical"] },
    "verified_at": { "type": "string", "format": "date" },
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+_-]*$" }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "topics"],
      "properties": {
        "area": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what_it_is", "why_it_exists", "how_it_works", "architecture", "concepts",
        "use_cases", "alternatives", "security", "performance", "learning_path"
      ],
      "properties": {
        "what_it_is": { "type": "string", "minLength": 80 },
        "why_it_exists": { "type": "string", "minLength": 80 },
        "how_it_works": { "type": "string", "minLength": 120 },
        "architecture": {
          "type": "array", "minItems": 2,
          "items": { "type": "string", "minLength": 20 }
        },
        "concepts": {
          "type": "array", "minItems": 3,
          "items": { "type": "string", "minLength": 10 }
        },
        "use_cases": {
          "type": "array", "minItems": 3,
          "items": { "type": "string", "minLength": 15 }
        },
        "alternatives": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "tradeoff"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "tradeoff": { "type": "string", "minLength": 30 }
            }
          }
        },
        "security": { "type": "string", "minLength": 80 },
        "performance": { "type": "string", "minLength": 80 },
        "learning_path": {
          "type": "array", "minItems": 4,
          "items": { "type": "string", "minLength": 10 }
        },
        "operations": { "type": "string", "minLength": 60 },
        "ecosystem": { "type": "string", "minLength": 60 },
        "examples": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 15 }
        },
        "prerequisites": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 10 }
        }
      }
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": [
              "alternative-to", "based-on", "built-with", "compatible-with", "depends-on",
              "extends", "implements", "integrates-with", "part-of", "predecessor-of",
              "related-to", "replaces", "secures", "successor-of", "used-by", "uses"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9._-]*$"
          },
          "note": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "type"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "type": { "enum": ["official", "repository", "standard", "advisory", "research", "documentation"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "enum": [2, 3, 4] } } },
      "then": { "required": ["kind", "domains"] }
    },
    {
      "if": { "properties": { "schema_version": { "enum": [3, 4] } } },
      "then": { "required": ["coverage"] }
    },
    {
      "if": { "properties": { "schema_version": { "const": 4 } } },
      "then": { "required": ["content"] }
    }
  ]
}
